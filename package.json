    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "graphql-yoga": "^5.16.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.548.0",
    "next": "16.0.0",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.65.0",
    "tailwind-merge": "^3.3.1",
    "urql": "^5.0.1",
    "zod": "^4.1.12"
